{
  "config": {
    "step": {
      "user": {
        "title": "Huawei OptiXstar ONT",
        "description": "Enter the connection details for your Huawei ONT router.",
        "data": {
          "host": "Host",
          "username": "Username",
          "password": "Password",
          "scan_interval": "Scan interval (seconds)"
        }
      }
    },
    "error": {
      "cannot_connect": "Unable to connect to the router",
      "invalid_auth": "Invalid username or password"
    },
    "abort": {
      "already_configured": "This router is already configured"
    }
  },
  "entity": {
    "sensor": {
      "cpu_usage": {
        "name": "CPU usage"
      },
      "memory_usage": {
        "name": "Memory usage"
      },
      "wan_ip": {
        "name": "WAN IP address"
      },
      "wan_uptime": {
        "name": "WAN uptime"
      },
      "bytes_sent": {
        "name": "Bytes sent"
      },
      "bytes_received": {
        "name": "Bytes received"
      },
      "packets_sent": {
        "name": "Packets sent"
      },
      "packets_received": {
        "name": "Packets received"
      },
      "connected_devices": {
        "name": "Connected devices"
      },
      "wifi_clients": {
        "name": "Wi-Fi clients"
      },
      "lan_clients": {
        "name": "LAN clients"
      },
      "download_rate": {
        "name": "Download rate"
      },
      "upload_rate": {
        "name": "Upload rate"
      },
      "optical_temperature": {
        "name": "Temperature"
      },
      "optical_voltage": {
        "name": "Supply voltage"
      },
      "free_ips": {
        "name": "Free addresses"
      }
    },
    "binary_sensor": {
      "wan_connection": {
        "name": "WAN connection"
      },
      "ont_status": {
        "name": "ONT status"
      }
    },
    "button": {
      "reboot": {
        "name": "Reboot"
      }
    }
  },
  "services": {
    "set_static_ip": {
      "name": "Set static IP",
      "description": "Reserve an IP address for a device on the router's DHCP server. Takes effect when the device next renews its lease or reconnects.",
      "fields": {
        "entity_id": {
          "name": "Device tracker",
          "description": "The device to reserve an address for."
        },
        "mac_address": {
          "name": "MAC address",
          "description": "Use instead of a device tracker, e.g. for a device that is offline."
        },
        "ip_address": {
          "name": "IP address",
          "description": "The address to reserve. Leave empty to pin the address the device has now."
        },
        "force": {
          "name": "Force",
          "description": "Reserve the address even though another device is using it right now. That device keeps it until its lease runs out."
        }
      }
    },
    "clear_static_ip": {
      "name": "Clear static IP",
      "description": "Remove a device's DHCP reservation.",
      "fields": {
        "entity_id": {
          "name": "Device tracker",
          "description": "The device to release."
        },
        "mac_address": {
          "name": "MAC address",
          "description": "Use instead of a device tracker."
        }
      }
    }
  }
}
